{
  "uid": "tr-database",
  "title": "TicketRush / Database",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "tags": [
    "ticketrush"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Postgres connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends{datname!=\"\"}",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Hikari active connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Hikari pending threads",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Connection acquire p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(hikaricp_connections_acquire_seconds_bucket[1m])))",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Transactions per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit{datname!=\"\"}[1m])+rate(pg_stat_database_xact_rollback{datname!=\"\"}[1m])",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sessions waiting on locks",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ticketrush_database_lock_waits",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Deadlocks per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_deadlocks[1m])",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Slow query fingerprints (mean >=250ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ticketrush_database_slow_query_fingerprints",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Buffer cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_blks_hit[1m])/clamp_min(rate(pg_stat_database_blks_hit[1m])+rate(pg_stat_database_blks_read[1m]),1)",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    }
  ]
}
