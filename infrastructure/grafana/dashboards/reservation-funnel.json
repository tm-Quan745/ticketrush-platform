{
  "uid": "tr-reservation-funnel",
  "title": "TicketRush / Reservation Funnel",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "tags": [
    "ticketrush"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Reservation attempts by result",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(reservation_attempts_total[1m]))",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Orders created",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ticketrush_funnel_orders_created",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Orders paid",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ticketrush_funnel_orders_paid",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tickets issued",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ticketrush_funnel_tickets_issued",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Inventory remaining (eight bounded slots)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ticketrush_inventory_remaining",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    }
  ]
}
