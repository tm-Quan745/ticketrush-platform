{
  "uid": "tr-jvm-containers",
  "title": "TicketRush / Jvm Containers",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "tags": [
    "ticketrush"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Backend process CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "JVM heap used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance)(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GC pause max",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_gc_pause_seconds_max",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM threads",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_threads_live_threads",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tomcat busy threads",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tomcat_threads_busy_threads",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Container CPU cores",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(name)(rate(container_cpu_usage_seconds_total{image!=\"\"}[1m]))",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Container memory working set",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{image!=\"\"}",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Container threads",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_threads{image!=\"\"}",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    }
  ]
}
