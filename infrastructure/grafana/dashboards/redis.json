{
  "uid": "tr-redis",
  "title": "TicketRush / Redis",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "tags": [
    "ticketrush"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Redis commands per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Lettuce command latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,command)(rate(lettuce_command_completion_seconds_bucket[1m])))",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Redis memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Keyspace hit rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_keyspace_hits_total[1m])/clamp_min(rate(redis_keyspace_hits_total[1m])+rate(redis_keyspace_misses_total[1m]),1)",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Redis gate active (0 = inactive or circuit open)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_gate_active",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Redis circuit open",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_circuit_open",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Fallback operations",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(feature)(rate(redis_fallback_total[1m]))",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Inventory drift (last reconciliation)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inventory_drift",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Public event cache hits",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cache_hit_total[1m])",
          "legendFormat": "{{uri}}{{result}}{{slot}}{{name}}{{queue}}{{command}}"
        }
      ]
    }
  ]
}
