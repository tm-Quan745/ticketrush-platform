FROM node:22-alpine AS build
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/tsconfig.json frontend/vite.config.ts frontend/index.html ./
COPY frontend/server.ts frontend/notification-proxy.ts ./
COPY frontend/src ./src
COPY docs/performance/results/finish-sellout-20-2.json /app/docs/performance/results/finish-sellout-20-2.json
COPY docs/performance/results/finish-sellout-20-2-verify.json /app/docs/performance/results/finish-sellout-20-2-verify.json
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run lint && npm run build

FROM node:22-alpine
WORKDIR /app/frontend
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
COPY --from=build /app/frontend/node_modules ./node_modules
COPY --from=build /app/frontend/dist ./dist
COPY frontend/package.json frontend/server.ts frontend/notification-proxy.ts ./
USER node
EXPOSE 3000
CMD ["node", "--import", "tsx", "server.ts"]

