FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json vite.config.ts index.html ./
COPY frontend/src ./frontend/src
COPY docs/performance/results/finish-sellout-20-2.json docs/performance/results/finish-sellout-20-2.json
COPY docs/performance/results/finish-sellout-20-2-verify.json docs/performance/results/finish-sellout-20-2-verify.json
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run lint && npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/frontend/dist ./frontend/dist
COPY package.json server.ts ./
USER node
EXPOSE 3000
CMD ["node", "--import", "tsx", "server.ts"]

