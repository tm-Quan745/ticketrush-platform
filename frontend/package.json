{
  "name": "ticketrush-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "start": "tsx server.ts",
    "test": "tsx --test tests/*.test.ts",
    "dev:isolated": "node --env-file=../.env.frontend.local --import tsx server.ts",
    "test:smoke": "tsx tests/smoke.ts",
    "api:generate": "node scripts/generate-api.mjs",
    "test:e2e": "playwright test",
    "docs:access": "tsx scripts/generate-access-doc.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
