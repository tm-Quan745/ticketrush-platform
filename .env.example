# Host-side Spring Boot settings. Compose overrides service hosts internally.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/ticketrush
POSTGRES_DB=ticketrush
POSTGRES_PORT=5432
POSTGRES_USER=ticketrush
POSTGRES_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_USER=ticketrush
RABBITMQ_PASSWORD=
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025
# Generate 32 random bytes encoded as Base64. See README.
JWT_SECRET=
BACKEND_PORT=8080
# Development fixtures only (never active in prod or test).
DEV_SEED_ENABLED=true
DEV_SEED_EVENTS=50
DEV_SEED_TIERS_PER_EVENT=3

# Week 3 PostgreSQL reservation settings
RESERVATION_STRATEGY=conditional-update
RESERVATION_HOLD_DURATION=10m
RESERVATION_JOB_INTERVAL=30s
RESERVATION_BATCH_SIZE=100
RESERVATION_OPTIMISTIC_ATTEMPTS=20
RESERVATION_EXPIRY_ENABLED=true

# Week 4: use a random secret of at least 32 characters.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_URL=http://127.0.0.1:8080/api/v1/payments/webhook
MOCK_PAYMENT_DELAY=500ms
MOCK_PAYMENT_DELAYED_SUCCESS=11m
MOCK_PAYMENT_DUPLICATE_COUNT=20
PAYMENT_TIMESTAMP_TOLERANCE=5m
PAYMENT_LATE_GRACE=5m
# Explicitly opt in for dev only; prod always rejects scenario headers.
MOCK_PAYMENT_SCENARIOS_ENABLED=false
MOCK_PAYMENT_TEST_TOKEN=

# Week 5 outbox, RabbitMQ and email settings
OUTBOX_RELAY_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_INITIAL_BACKOFF=1s
OUTBOX_MAX_BACKOFF=5m
OUTBOX_CONFIRM_TIMEOUT=5s
OUTBOX_CLEANUP_INTERVAL=24h
OUTBOX_RETENTION_DAYS=7
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_CONCURRENCY=2
NOTIFICATION_PREFETCH=10
